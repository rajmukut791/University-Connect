APP_NAME="University Connect"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR_DOMAIN
# Copy your existing APP_KEY securely when importing encrypted files. Do not regenerate it.
APP_KEY=
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
# Set these to persistent mounted directories on the production host.
PRIVATE_STORAGE_PATH=
PUBLIC_STORAGE_PATH=
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="University Connect"
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=bdt
# Supply a real TURN relay for reliable calls across restrictive networks.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=
